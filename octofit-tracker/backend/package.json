  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/cors": "^2.8.17"
  }
}
